# Copy to .env next to docker-compose.yml and fill in. .env holds real secrets
# and must never be committed - deploy/.env is gitignored.

# Public hostname, without scheme or trailing slash. Must already resolve to
# this server, or Caddy cannot obtain a certificate.
DOMAIN=silpo-bot.duckdns.org

# Encrypts Silpo access and refresh tokens inside the data tables.
# Exactly 64 hex characters:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# From @BotFather. Needed as an environment variable - not only as an n8n
# credential - because the selection card builds its inline keyboard in a Code
# node, and Code nodes cannot read credentials.
TELEGRAM_BOT_TOKEN=

# n8n's own key for encrypting stored credentials. A DIFFERENT value from
# TOKEN_ENCRYPTION_KEY above; reusing one for both means a single leak exposes
# both layers. Also 64 hex characters:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Optional; defaults to Europe/Kyiv.
TZ=Europe/Kyiv

# Node heap ceiling in MB. The default of 768 is sized for a 1 GB always-free
# box; on a 4 GB VPS (Hetzner CAX11/CX22) set 3072.
N8N_MAX_OLD_SPACE=768
