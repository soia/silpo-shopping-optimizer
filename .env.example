# Local development only. Copy to .env — it is gitignored.
#
# This file is NOT how the bot is configured. The deployed workflows read their
# settings from n8n Variables and Credentials (see docs/setup.md), and the
# instance URL and data table ids live in .secrets/n8n.json.
#
# The single variable below is read by `npm run optimize`, which runs the
# pipeline locally without n8n.

# Enables the semantic layer during a local run. Without it the deterministic
# fallback is used, which rejects more aggressively and reports a lower saving.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
